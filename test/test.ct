test tests traction.

``//test_traction.py:
``import``
``test_run``
``

test run tries to start up traction and to a query.

``/test_run:
def test_run():
    ``.``
``

take a live sampleid.

``
    sampleid = "1478370269"
``

start up traction and get a sample.

``
    trac = tr.traction("num_test")
    res = trac.sample(sampleids=[sampleid], verbose_all=True)
    assert len(res) == 1
``

check the sample.

``
    sample = res[0]
    assert sample.locationpath == "NUM --> HGW Greifswald --> PP Lager RT SNID"
    assert sample.id("EXTSAMPLEID") == "asdf4"
    assert sample.patient.id("LIMSPSN") == "fim-1"
``

fetch an aliquot and include a reference to its primary parent.

get the result keyed by sampleids.

``
    aqt = "LV9517349484"
    res = trac.sample(sampleids=[aqt], primaryref=True, by=tr.sampleid)
``

check that both the aliquot and the primary are there.

``
    assert aqt in res
    assert res[aqt][0].primary.id() == "1438540007"
``

get trials.

``
    res = trac.trial()
    hassnid = False
    for r in res:
        if r.code == "NUM S-SNID":
            hassnid = True
    assert hassnid == True
``

get the patient for a sample.

``
    res = trac.patient(sampleids=[sampleid])
    assert len(res) == 1
``

check the patient.

``
    pat = res[0]
    assert pat.id("LIMSPSN") == "fim-1"
``

get the findings for the sample.

``
    res = trac.finding(sampleids=[sampleid])
    assert len(res) == 1
``

check the finding.

``
    finding = res[0]
    assert "DENGUE" in finding.recs["PATHOGEN2"].rec
``

get methods.

``
    res = trac.method()
``

get users.

``
    res = trac.user(usernames=["hauboldm"], verbose_all=True)
    assert res[0].address.email == "max.haubold@med.uni-greifswald.de"
``

get a catalog.

``
    res = trac.catalog(catalogs=["PATHOGEN"])
    assert res["PATHOGEN"]["entries"]["CHIKUNGUNYA"]["name_de"] == "Chikungunya"
``

get usageentries.

``
    res = trac.usageentry()
    assert res["YES"]["name_de"] == "ja"
``

fetch a kittemplate and its sampletemplates.

``
    kt = "RAPID_ELAPSE_STD_STUDYSET"
    res = trac.kittemplate(kittemplates=[kt])
    assert kt in res    
``

make sure that one of the sampletemplates is there, and that it comes with the right info.

``
    st = "RAPID_ELAPSE_HEP_POOL_PL"
    assert st in res[kt]["sampletemplates"]
    sample = res[kt]["sampletemplates"][st]["sample"]
    assert sample.type == "NUM_HEP_POOL_PL"
``
    

get locations.

``
    res = trac.location(locationids=["NUM"])
    assert res[0].path == "NUM"
``

